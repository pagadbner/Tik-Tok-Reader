<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#090B18</item>
        <item name="android:colorAccent">#9B86FF</item>
        <item name="android:statusBarColor">#090B18</item>
        <item name="android:navigationBarColor">#090B18</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.TikLBot.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090B18</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
