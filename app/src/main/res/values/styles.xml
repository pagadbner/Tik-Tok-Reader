<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#07090D</item>
        <item name="android:colorAccent">#9AA3AE</item>
        <item name="android:statusBarColor">#07090D</item>
        <item name="android:navigationBarColor">#07090D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.TikLBot.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#07090D</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
